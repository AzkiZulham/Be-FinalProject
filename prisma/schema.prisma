generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int           @id @default(autoincrement())
  role                Role
  username            String
  email               String        @unique
  password            String?
  profileImg          String?
  resetToken          String?
  verifyToken         String?       @db.VarChar(500)
  resetTokenExpireAt  DateTime?
  verifyTokenExpireAt DateTime?
  isVerified          Boolean       @default(false)
  updatedAt           DateTime      @updatedAt
  createdAt           DateTime      @default(now())
  isEmailVerified     Boolean       @default(false)
  phoneNumber         String?       @db.VarChar(20)
  birthDate           DateTime?
  gender              Gender?
  properties          Property[]
  reviews             Review[]
  transactions        Transaction[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Property {
  id              Int                @id @default(autoincrement())
  categoryId      Int
  userId          Int
  name            String
  description     String?
  picture         String?
  address         String
  city            String
  longitude       String?
  latitude        String?
  noRekening      String?
  destinationBank String?
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
  category        propertycategories @relation(fields: [categoryId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
  reviews         Review[]
  roomtypes       roomtypes[]

  @@index([categoryId], map: "properties_categoryId_fkey")
  @@index([userId], map: "properties_userId_fkey")
  @@map("properties")
}

model Transaction {
  id           Int               @id @default(autoincrement())
  userId       Int
  roomTypeId   Int
  status       TransactionStatus
  checkInDate  DateTime
  checkOutDate DateTime
  qty          Int
  totalPrice   Int
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())
  payment      Payment?
  review       Review?
  roomType     roomtypes         @relation(fields: [roomTypeId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([roomTypeId], map: "transactions_roomTypeId_fkey")
  @@index([userId], map: "transactions_userId_fkey")
  @@map("transactions")
}

model Review {
  id            Int         @id @default(autoincrement())
  userId        Int
  propertyId    Int
  transactionId Int         @unique
  comment       String?
  tenantReply   String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())
  property      Property    @relation(fields: [propertyId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([propertyId], map: "reviews_propertyId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
  @@map("reviews")
}

model Payment {
  id            Int           @id @default(autoincrement())
  transactionId Int           @unique
  method        MethodPayment
  paymentProof  String?
  midtransId    String?
  paymentType   String?
  paymentStatus String?
  fraudStatus   String?
  paymentUrl    String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transaction   Transaction   @relation(fields: [transactionId], references: [id])

  @@map("payments")
}

model peakseason {
  id          Int       @id @default(autoincrement())
  roomTypeId  Int
  isAvailable Boolean   @default(true)
  startDate   DateTime
  endDate     DateTime
  percentage  Float?
  nominal     Int?
  updatedAt   DateTime
  createdAt   DateTime  @default(now())
  roomtypes   roomtypes @relation(fields: [roomTypeId], references: [id], map: "peakSeason_roomTypeId_fkey")

  @@index([roomTypeId], map: "peakSeason_roomTypeId_fkey")
}

model propertycategories {
  id         Int        @id @default(autoincrement())
  category   String
  updatedAt  DateTime
  createdAt  DateTime   @default(now())
  properties Property[]
}

model roomtypes {
  id           Int           @id @default(autoincrement())
  propertyId   Int
  roomName     String
  price        Int
  description  String?
  roomImg      String?
  quota        Int
  adultQty     Int
  childQty     Int
  updatedAt    DateTime
  createdAt    DateTime      @default(now())
  peakseason   peakseason[]
  properties   Property      @relation(fields: [propertyId], references: [id], map: "roomTypes_propertyId_fkey")
  transactions Transaction[]

  @@index([propertyId], map: "roomTypes_propertyId_fkey")
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  ACCEPTED
  CANCELLED
}

enum MethodPayment {
  TRANSFER
  MIDTRANS
}

enum Role {
  USER
  TENANT
}


